# Shared secret. The phone sends this on every request.
# Leave this blank and run start.sh / start.bat once. The script fills it in
# and prints the key for you to type into the phone.
API_KEY=

# Ollama is already installed. This is the address it listens on.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fast default for a 12 GB NVIDIA card.
# The ollama tag qwen2.5:7b is the instruct model at Q4_K_M, about 4.7 GB,
# so weights plus a 4096-token cache fit with room to spare.
DEFAULT_MODEL=qwen2.5:7b

# -1 keeps the model loaded in VRAM until you stop Ollama. No cold start.
KEEP_ALIVE=-1

# Context length. 4096 is the speed setting. Raise it for longer chats.
NUM_CTX=4096

# 0.0.0.0 so the phone can connect over Wi-Fi and Tailscale.
HOST=0.0.0.0
PORT=8787

# Load the model into VRAM when this server starts.
WARM_ON_START=1

# Files the phone can read and write. Blank uses only ~/Desk (created automatically).
# Add project folders as semicolon-separated absolute paths, then restart:
# ALLOWED_ROOTS=C:\Users\Austin\Desk;D:\Projects
# ALL requires ALLOW_ALL_DRIVES=1 as a separate explicit opt-in.
ALLOWED_ROOTS=
ALLOW_ALL_DRIVES=0

# Largest file the phone can upload, in megabytes.
MAX_UPLOAD_MB=200

# Largest text file Desk will open for editing or send to the model, in bytes.
MAX_TEXT_BYTES=1000000

# Used when you ask the model to change a code file, if `ollama list` has it.
# Otherwise Desk uses DEFAULT_MODEL.
CODER_MODEL=ornith-1.5:9b

